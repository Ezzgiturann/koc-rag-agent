# Bu dosya şablondur ve commit'lenir. Kullanmak için:
#   cp .env.example .env
# sonra .env içine gerçek değerleri yaz. .env asla commit'lenmez.

# Gemini API anahtarı (https://aistudio.google.com → Get API key)
GEMINI_API_KEY=

# OpenAI uyumlu uç nokta. OpenAI'ye geçersen: https://api.openai.com/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model adları (kullanmadan önce dokümandan doğrula)
CHAT_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2

# Milvus Lite veritabanı dosyası (demoda Docker adresi olur: http://localhost:19530)
MILVUS_URI=./data/milvus.db
